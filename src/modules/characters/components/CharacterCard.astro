---
import type { CharacterDTO } from "@modules/characters/types/character.types";

interface Props {
  character: CharacterDTO;
}

const { character } = Astro.props;

const imageSrc = character.avatarUrl || "/images/characters/placeholder.svg";
const rawJson = JSON.stringify(character);
---

<article
  class="character-card group relative bg-card rounded-2xl overflow-hidden border border-smoke hover:border-accent transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_0_28px_rgba(127,255,212,0.22)] cursor-pointer flex flex-col justify-between"
  role="button"
  tabindex="0"
  data-character={rawJson}
  aria-label={`Ver ficha y JSON de ${character.name}`}
>
  <!-- Corner Sci-Fi accents -->
  <div class="absolute top-0 left-0 w-2.5 h-2.5 border-t border-l border-accent opacity-40 group-hover:opacity-100 transition-opacity z-10"></div>
  <div class="absolute top-0 right-0 w-2.5 h-2.5 border-t border-r border-accent opacity-40 group-hover:opacity-100 transition-opacity z-10"></div>
  <div class="absolute bottom-0 left-0 w-2.5 h-2.5 border-b border-l border-accent opacity-40 group-hover:opacity-100 transition-opacity z-10"></div>
  <div class="absolute bottom-0 right-0 w-2.5 h-2.5 border-b border-r border-accent opacity-40 group-hover:opacity-100 transition-opacity z-10"></div>

  <div>
    <!-- Imagen con ratio 3:4 -->
    <picture class="aspect-[3/4] overflow-hidden bg-surface block relative">
      <img
        src={imageSrc}
        alt={character.name}
        class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-card via-transparent to-transparent opacity-85"></div>

      <!-- Badge ID / Canon -->
      <div class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md bg-base/85 backdrop-blur-md border border-accent/30 text-[10px] font-mono text-accent font-bold">
        #{character.id.padStart(3, "0")}
      </div>

      <!-- Hint "Click para JSON" -->
      <div class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-md bg-base/90 backdrop-blur-md border border-accent/50 text-[10px] font-mono text-accent opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1 shadow-[0_0_10px_rgba(127,255,212,0.3)]">
        <span>{`{ }`} JSON</span>
      </div>
    </picture>

    <!-- Información -->
    <div class="p-4">
      <h2 class="text-sm sm:text-base font-bold text-primary group-hover:text-accent transition-colors line-clamp-1 font-orbitron">
        {character.name}
      </h2>

      {character.description ? (
        <p class="mt-1.5 text-xs text-muted line-clamp-2 leading-relaxed font-inter">
          {character.description}
        </p>
      ) : (
        <p class="mt-1.5 text-xs text-dim italic font-inter">
          Perfil registrado en el archivo.
        </p>
      )}
    </div>
  </div>

  <!-- Tags en la base -->
  <div class="px-4 pb-3.5 pt-2.5 border-t border-smoke/50 flex items-center justify-between text-[11px] text-muted">
    <span class="capitalize font-mono truncate max-w-[110px]">
      {character.species?.[0] || (character.gender !== "unknown" ? character.gender : "Canon")}
    </span>
    <span class="text-accent font-mono text-[10px] font-semibold group-hover:translate-x-0.5 transition-transform">
      Ficha + API →
    </span>
  </div>
</article>
