---
import type { CharacterDTO } from "@modules/characters/types/character.types";
import CharacterCard from "@modules/characters/components/CharacterCard.astro";

interface Props {
  characters: CharacterDTO[];
}

const { characters } = Astro.props;
---

<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 md:gap-5">
  {characters.map((character) => <CharacterCard character={character} />)}
</div>
