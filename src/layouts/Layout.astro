---
import "@styles/global.css";
import SEO from "@components/layout/SEO.astro";
import Cursor from "@components/layout/Cursor.astro";
import SmoothScroll from "@components/layout/SmoothScroll.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Star Wars Holocron API",
  description = "Catálogo interactivo y API REST canónica del universo Star Wars",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEO title={title} description={description} />
  </head>
  <body class="bg-base text-primary antialiased">
    <Cursor />
    <SmoothScroll />
    <slot />
  </body>
</html>
