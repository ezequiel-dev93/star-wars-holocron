---
import "@styles/global.css";
import SEO from "@presentation/common/SEO.astro";
import Cursor from "@presentation/common/Cursor.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Star Wars Holocron API",
  description = "Catalogo interactivo del universo Star Wars",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEO title={title} description={description} />
  </head>
  <body>
    <Cursor />
    <slot />
  </body>
</html>
