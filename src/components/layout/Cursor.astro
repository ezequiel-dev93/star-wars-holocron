---
// Cursor Sable de Luz — Star Wars Holocron
---

<div id="sw-cursor" aria-hidden="true">
  <div id="sw-cursor-dot"></div>
  <div id="sw-cursor-glow"></div>
  <div id="sw-cursor-ring"></div>
</div>

<style>
  @media (pointer: fine) {
    :global(html.cursor-ready),
    :global(html.cursor-ready a),
    :global(html.cursor-ready button),
    :global(html.cursor-ready [role="button"]) {
      cursor: none;
    }
  }

  #sw-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
  }

  @media (pointer: coarse) {
    #sw-cursor {
      display: none;
    }
  }

  #sw-cursor-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 4px 2px rgba(127, 255, 212, 1),
      0 0 8px 4px rgba(127, 255, 212, 0.9),
      0 0 16px 6px rgba(0, 168, 120, 0.6);
    transform: translate(-50%, -50%);
    will-change: transform;
  }

  #sw-cursor-glow {
    position: absolute;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(127, 255, 212, 0.25) 0%, transparent 70%);
    transform: translate(-50%, -50%);
    will-change: transform;
    transition: width 0.15s ease, height 0.15s ease;
  }

  #sw-cursor-ring {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid rgba(127, 255, 212, 0.6);
    transform: translate(-50%, -50%);
    will-change: transform;
    transition: border-color 0.2s ease;
  }

  :global(html.cursor-hover) #sw-cursor-dot {
    box-shadow:
      0 0 6px 3px rgba(127, 255, 212, 1),
      0 0 14px 6px rgba(127, 255, 212, 0.9),
      0 0 28px 10px rgba(0, 168, 120, 0.5);
  }

  :global(html.cursor-hover) #sw-cursor-glow {
    width: 44px;
    height: 44px;
  }

  :global(html.cursor-hover) #sw-cursor-ring {
    border-color: rgba(127, 255, 212, 0.9);
  }
</style>

<script>
  import { gsap } from "@lib/gsap/index.ts";

  const dot = document.getElementById("sw-cursor-dot");
  const glow = document.getElementById("sw-cursor-glow");
  const ring = document.getElementById("sw-cursor-ring");

  if (dot && glow && ring) {
    document.documentElement.classList.add("cursor-ready");
    let mouseX = -200;
    let mouseY = -200;
    let glowX = -200;
    let glowY = -200;

    window.addEventListener("mousemove", (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      gsap.set(dot, { x: mouseX, y: mouseY });
    });

    gsap.ticker.add(() => {
      glowX += (mouseX - glowX) * 0.12;
      glowY += (mouseY - glowY) * 0.12;
      gsap.set(glow, { x: glowX, y: glowY });
      gsap.set(ring, { x: glowX, y: glowY });
    });

    window.addEventListener("click", (e) => {
      const pulse = document.createElement("div");
      pulse.style.cssText = `
        position: fixed;
        left: ${e.clientX}px;
        top: ${e.clientY}px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        border: 2px solid rgba(127, 255, 212, 0.9);
        pointer-events: none;
        z-index: 9998;
        transform: translate(-50%, -50%);
      `;
      document.body.appendChild(pulse);

      gsap.to(pulse, {
        width: 60,
        height: 60,
        opacity: 0,
        duration: 0.5,
        ease: "power2.out",
        onComplete: () => pulse.remove(),
      });
    });

    const interactives = "a, button, [role='button'], input, label, select, textarea";
    document.querySelectorAll(interactives).forEach((el) => {
      el.addEventListener("mouseenter", () =>
        document.documentElement.classList.add("cursor-hover")
      );
      el.addEventListener("mouseleave", () =>
        document.documentElement.classList.remove("cursor-hover")
      );
    });

    document.addEventListener("mouseleave", () => {
      gsap.to([dot, glow, ring], { opacity: 0, duration: 0.2 });
    });
    document.addEventListener("mouseenter", () => {
      gsap.to([dot, glow, ring], { opacity: 1, duration: 0.2 });
    });
  }
</script>
