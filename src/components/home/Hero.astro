---
import Link from "@components/ui/Link.astro";
import SectionContainer from "@components/ui/SectionContainer.astro";
---

<section class="relative w-full min-h-screen flex items-center justify-center overflow-hidden pt-28 pb-20 border-b border-smoke/50">
  <!-- Three.js Starfield Canvas Background (desde @lib) -->
  <canvas
    id="starfield-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none opacity-80"
  ></canvas>

  <!-- Retícula holográfica sutil y luces de ambiente -->
  <div class="absolute inset-0 holocron-grid-bg pointer-events-none opacity-50"></div>
  <div class="absolute top-1/4 left-1/4 -translate-x-1/2 w-[550px] h-[350px] bg-accent/10 blur-[150px] rounded-full pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-[450px] h-[300px] bg-accent/5 blur-[130px] rounded-full pointer-events-none"></div>

  <SectionContainer class="relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      <!-- Columna Izquierda: Mensaje Principal, CTAs y Quick Endpoint -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Cyber Status Pill -->
        <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-surface/90 border border-accent/35 text-accent text-xs font-mono font-semibold uppercase tracking-widest mb-6 shadow-[0_0_24px_rgba(127,255,212,0.15)]">
          <span class="w-2 h-2 rounded-full bg-accent animate-ping"></span>
          <span>REST API • V1.0 GALACTIC ARCHIVE</span>
        </div>

        <!-- Título Principal Imponente -->
        <h1 class="text-4xl sm:text-5xl xl:text-6xl font-black text-primary font-orbitron tracking-tight leading-[1.08]">
          TODA LA INFORMACIÓN DE{" "}
          <span class="text-accent neon-mint block mt-2">
            STAR WARS
          </span>
        </h1>

        <!-- Subtítulo -->
        <p class="mt-6 text-base sm:text-lg text-muted max-w-2xl font-inter leading-relaxed">
          Un proyecto creado para reunir un <span class="text-primary font-semibold">Star Wars completo con toda su información</span> en un solo lugar: más de <span class="text-primary font-semibold">364 personajes</span>, retratos HD y una{" "}
          <span class="text-accent font-semibold">API REST abierta</span>. Si quieres colaborar sumando datos o nuevas rutas, ¡las puertas están abiertas!
        </p>

        <!-- Barra de Acciones con componente <Link /> -->
        <div class="mt-8 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <Link href="/characters" variant="primary" size="lg">
            <span>⚔️ Explorar Personajes</span>
            <span class="font-mono text-xs opacity-80">(364)</span>
          </Link>

          <Link href="#terminal-sandbox" variant="outline" size="lg">
            <span>⚡ Probar API en Vivo</span>
            <span>↓</span>
          </Link>

          <Link href="/introduccion" variant="secondary" size="lg">
            <span>📜 Documentación</span>
            <span>↗</span>
          </Link>
        </div>

        <!-- Quick Endpoint Copy Bar -->
        <div class="mt-8 w-full max-w-xl rounded-xl bg-card/90 border border-smoke p-2 pl-4 flex items-center justify-between gap-3 backdrop-blur-md">
          <div class="flex items-center gap-2.5 overflow-x-auto font-mono text-xs">
            <span class="px-2 py-0.5 rounded bg-accent/15 text-accent font-bold border border-accent/30 shrink-0">
              GET
            </span>
            <code id="hero-endpoint-code" class="text-primary/90 truncate">
              /api/characters/luke-skywalker
            </code>
          </div>
          <button
            id="hero-copy-endpoint"
            type="button"
            class="px-3 py-1.5 rounded-lg bg-surface hover:bg-elevated text-accent border border-smoke hover:border-accent/40 text-xs font-mono font-semibold transition-colors shrink-0 cursor-pointer"
          >
            Copiar URL
          </button>
        </div>
      </div>

      <!-- Columna Derecha: Consola Holográfica & Métricas del Archivo -->
      <div class="lg:col-span-5 flex flex-col gap-5">
        <!-- Dossier Holográfico en Vivo -->
        <div class="relative rounded-2xl bg-card/90 border border-accent/35 p-5 sm:p-6 shadow-[0_0_45px_rgba(127,255,212,0.12)] backdrop-blur-xl overflow-hidden">
          <!-- Esquinas Sci-Fi -->
          <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-accent"></div>
          <div class="absolute top-0 right-0 w-3 h-3 border-t-2 border-r-2 border-accent"></div>
          <div class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 border-accent"></div>
          <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-accent"></div>

          <!-- Cabecera de telemetría -->
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-smoke/70 text-xs font-mono">
            <div class="flex items-center gap-2 text-accent">
              <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
              <span class="font-bold tracking-wider">HOLOCRON LIVE RECORD</span>
            </div>
            <span class="px-2 py-0.5 rounded bg-surface border border-smoke text-muted">
              200 OK • 0ms
            </span>
          </div>

          <!-- Perfil destacado + Mini JSON -->
          <div class="grid grid-cols-12 gap-4 items-center">
            <div class="col-span-4 aspect-[3/4] rounded-xl overflow-hidden border border-smoke bg-surface relative">
              <img
                src="/images/characters/ahsoka-tano.jpeg"
                alt="Ahsoka Tano"
                class="w-full h-full object-cover object-top"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-base/80 via-transparent to-transparent"></div>
              <span class="absolute bottom-2 left-2 px-1.5 py-0.5 rounded bg-base/90 border border-accent/40 text-[10px] font-mono text-accent">
                #003
              </span>
            </div>

            <div class="col-span-8 flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <h2 class="text-base sm:text-lg font-extrabold text-primary font-orbitron">
                  Ahsoka Tano
                </h2>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-accent/15 text-accent border border-accent/30">
                  Togruta
                </span>
              </div>
              <p class="text-xs text-muted line-clamp-2 font-inter">
                Ex Padawan Jedi de Anakin Skywalker y pieza clave de la Alianza Rebelde bajo el nombre clave Fulcrum.
              </p>
              <pre class="mt-1 p-3 rounded-xl bg-deep border border-smoke/80 text-[11px] font-mono text-accent overflow-x-auto leading-relaxed"><code>&#123;
  "id": "45",
  "slug": "ahsoka-tano",
  "homeworld": "Shili",
  "height": "176"
&#125;</code></pre>
            </div>
          </div>
        </div>

        <!-- Grid de 4 Métricas del Holocron -->
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 gap-3.5">
          <div class="p-4 rounded-xl bg-card/85 border border-smoke hover:border-accent/50 transition-colors backdrop-blur-md">
            <p class="text-2xl sm:text-3xl font-extrabold text-accent font-orbitron">
              364
            </p>
            <p class="text-xs text-muted mt-1 uppercase tracking-wider font-mono">
              Personajes
            </p>
          </div>

          <div class="p-4 rounded-xl bg-card/85 border border-smoke hover:border-accent/50 transition-colors backdrop-blur-md">
            <p class="text-2xl sm:text-3xl font-extrabold text-primary font-orbitron">
              338
            </p>
            <p class="text-xs text-muted mt-1 uppercase tracking-wider font-mono">
              Retratos HD
            </p>
          </div>

          <div class="p-4 rounded-xl bg-card/85 border border-smoke hover:border-accent/50 transition-colors backdrop-blur-md">
            <p class="text-2xl sm:text-3xl font-extrabold text-accent font-orbitron">
              0ms
            </p>
            <p class="text-xs text-muted mt-1 uppercase tracking-wider font-mono">
              Respuesta Edge
            </p>
          </div>

          <div class="p-4 rounded-xl bg-card/85 border border-smoke hover:border-accent/50 transition-colors backdrop-blur-md">
            <p class="text-2xl sm:text-3xl font-extrabold text-primary font-orbitron">
              100%
            </p>
            <p class="text-xs text-muted mt-1 uppercase tracking-wider font-mono">
              Open Source
            </p>
          </div>
        </div>
      </div>
    </div>
  </SectionContainer>
</section>

<script>
  import { Starfield } from "@lib/three/Starfield.ts";

  function initStarfield() {
    const canvas = document.getElementById(
      "starfield-canvas"
    ) as HTMLCanvasElement | null;
    if (!canvas) return;
    const sf = new Starfield(canvas);

    document.addEventListener("astro:before-swap", () => sf.destroy(), {
      once: true,
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initStarfield, { once: true });
  } else {
    initStarfield();
  }

  const copyBtn = document.getElementById("hero-copy-endpoint");
  if (copyBtn) {
    copyBtn.addEventListener("click", async () => {
      const origin = window.location.origin;
      await navigator.clipboard.writeText(`${origin}/api/characters/luke-skywalker`);
      copyBtn.textContent = "¡Copiado!";
      setTimeout(() => {
        copyBtn.textContent = "Copiar URL";
      }, 2000);
    });
  }
</script>
