---
import type { HTMLAttributes } from "astro/types";

type LinkVariant =
  | "primary"
  | "secondary"
  | "outline"
  | "ghost"
  | "inline"
  | "nav"
  | "unstyled";

type LinkSize = "sm" | "md" | "lg";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: LinkVariant;
  size?: LinkSize;
  external?: boolean;
  class?: string | null;
}

const {
  href,
  variant = "inline",
  size = "md",
  external,
  class: className = "",
  ...rest
} = Astro.props;

const isExternal =
  external ?? (href.startsWith("http://") || href.startsWith("https://"));

const externalAttrs = isExternal
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};

const baseButtonClasses =
  "inline-flex items-center justify-center gap-2.5 font-orbitron font-bold uppercase tracking-wider rounded-xl transition-all duration-300 select-none";

const sizeClasses: Record<LinkSize, string> = {
  sm: "px-4 py-2 text-xs",
  md: "px-6 py-3 text-xs sm:text-sm",
  lg: "px-8 py-4 text-xs sm:text-sm",
};

const variantClasses: Record<LinkVariant, string> = {
  primary: `${baseButtonClasses} ${sizeClasses[size]} bg-accent text-base font-extrabold hover:bg-primary hover:-translate-y-0.5 shadow-[0_0_25px_rgba(127,255,212,0.45)] hover:shadow-[0_0_35px_rgba(127,255,212,0.75)]`,
  secondary: `${baseButtonClasses} ${sizeClasses[size]} bg-surface hover:bg-elevated text-primary border border-smoke hover:border-accent/60 hover:-translate-y-0.5`,
  outline: `${baseButtonClasses} ${sizeClasses[size]} bg-base/80 hover:bg-accent/10 text-accent border border-accent/40 hover:border-accent hover:-translate-y-0.5 shadow-[0_0_20px_rgba(127,255,212,0.12)]`,
  ghost: `${baseButtonClasses} ${sizeClasses[size]} bg-transparent hover:bg-surface text-muted hover:text-primary border border-transparent hover:border-smoke`,
  inline:
    "inline-flex items-center gap-1.5 text-accent hover:text-primary font-semibold transition-colors duration-200 hover:underline underline-offset-4",
  nav: "inline-flex items-center gap-2 px-4 py-2 rounded-full font-orbitron text-xs font-semibold tracking-wider text-primary/75 hover:text-accent hover:bg-accent/10 transition-all duration-200",
  unstyled: "transition-all duration-300",
};

const finalClass = `${variantClasses[variant]} ${className}`.trim();
---

<a href={href} class={finalClass} {...externalAttrs} {...rest}>
  <slot />
</a>
