<section class="hero">
    <div id="force-canvas" class="force-canvas"></div>

    <div class="hero-content"></div>
</section>

<style>
    .hero {
        position: relative;
        width: 100%;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(to bottom, #000000, #0a0a0a);
        overflow: hidden;
    }

    .force-canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 800px;
        padding: 2rem;
        color: white;
    }

    .hero-description {
        font-size: clamp(1rem, 2vw, 1.25rem);
        line-height: 1.8;
        margin-bottom: 2.5rem;
        color: rgba(255, 255, 255, 0.8);
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-cta {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    @media (max-width: 768px) {
        .hero-content {
            padding: 1rem;
        }

        .hero-cta {
            flex-direction: column;
            align-items: center;
        }
    }
</style>

<script>
    import { ForceParticles } from "@/lib/three/ForceParticles.js";

    const initForceParticles = () => {
        const container = document.getElementById("force-canvas");
        if (container) {
            new ForceParticles(container);
        }
    };

    // Initialize on page load
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initForceParticles);
    } else {
        initForceParticles();
    }
</script>
