---
import type { CharacterDTO } from "@/modules/characters/application/dtos/CharacterDTO";
import CharacterCard from "@/presentation/components/characters/CharacterCard.astro";

interface Props {
    characters: CharacterDTO[];
}

const { characters } = Astro.props;
---

<div
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6"
>
    {characters.map((character) => <CharacterCard character={character} />)}
</div>
