---
// DevTerminal.astro - Terminal de Desarrollo Galáctico interactiva con live runner
---

<section id="terminal-sandbox" class="relative z-10 py-20 bg-[#0A0A0A] border-t border-[#3D3D3D]/60">
  <div class="sectionContenedor">
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#121212] border border-[#7FFFD4]/30 text-[#7FFFD4] text-xs font-mono font-semibold uppercase tracking-widest mb-3">
        <span>⚡</span> API SANDBOX & DESARROLLADORES
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-[#F8FFF0] font-['Orbitron',sans-serif] tracking-wider">
        TERMINAL DE DESARROLLO
      </h2>
      <p class="mt-3 text-xs sm:text-base text-[#A3A3A3] font-['Inter',sans-serif]">
        Aprende a integrar el archivo canónico de Star Wars en minutos. Prueba peticiones en tiempo real y copia snippets listos para producción.
      </p>
    </div>

    <!-- Grid: Terminal a la izquierda, Características a la derecha -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Terminal Interactive Component (7 cols) -->
      <div class="lg:col-span-7 rounded-2xl bg-[#0E0E0E] border border-[#3D3D3D] shadow-[0_0_35px_rgba(0,0,0,0.8)] overflow-hidden">
        <!-- Terminal Titlebar -->
        <div class="flex flex-wrap items-center justify-between px-4 py-3 bg-[#141414] border-b border-[#3D3D3D] gap-3">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#FF5F56] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#FFBD2E] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#27C93F] inline-block"></span>
            <span class="ml-2 text-xs font-mono text-[#A3A3A3]">bash — holocron-runner</span>
          </div>

          <!-- Language Tabs -->
          <div class="flex items-center gap-1 bg-[#0A0A0A] p-1 rounded-lg border border-[#3D3D3D]/60 text-xs font-mono">
            <button
              class="terminal-tab-btn active px-3 py-1 rounded text-[#0A0A0A] bg-[#7FFFD4] font-bold transition-all"
              data-lang="curl"
            >
              cURL
            </button>
            <button
              class="terminal-tab-btn px-3 py-1 rounded text-[#A3A3A3] hover:text-[#F8FFF0] transition-all"
              data-lang="js"
            >
              JavaScript
            </button>
            <button
              class="terminal-tab-btn px-3 py-1 rounded text-[#A3A3A3] hover:text-[#F8FFF0] transition-all"
              data-lang="python"
            >
              Python
            </button>
          </div>
        </div>

        <!-- Endpoint Selector & Execution Controls -->
        <div class="px-5 py-3 bg-[#121212] border-b border-[#3D3D3D]/50 flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
          <div class="flex items-center gap-2">
            <span class="text-[#7FFFD4] font-bold">ENDPOINT:</span>
            <select
              id="endpoint-selector"
              class="bg-[#0A0A0A] text-[#F8FFF0] border border-[#3D3D3D] rounded-md px-2.5 py-1 focus:outline-none focus:border-[#7FFFD4]"
            >
              <option value="/api/characters/1">GET /api/characters/1 (Luke Skywalker)</option>
              <option value="/api/characters?page=1&limit=3">GET /api/characters (Paginado)</option>
              <option value="/api/characters?q=yoda">GET /api/characters?q=yoda (Búsqueda)</option>
            </select>
          </div>

          <div class="flex items-center gap-2">
            <button
              id="copy-snippet-btn"
              class="px-3 py-1 rounded bg-[#1C1C1C] hover:bg-[#2A2A2A] text-[#F8FFF0] border border-[#3D3D3D] transition-colors flex items-center gap-1.5"
            >
              <span id="copy-text">Copiar</span>
            </button>
            <button
              id="execute-request-btn"
              class="px-3.5 py-1 rounded bg-[#7FFFD4] text-[#0A0A0A] font-bold hover:bg-white transition-all shadow-[0_0_10px_rgba(127,255,212,0.4)] flex items-center gap-1.5"
            >
              <span>▶ Ejecutar</span>
            </button>
          </div>
        </div>

        <!-- Code Snippet Area -->
        <div class="p-5 font-mono text-xs bg-[#0A0A0A] overflow-x-auto border-b border-[#3D3D3D]/50">
          <pre id="code-snippet-display" class="text-[#7FFFD4] leading-relaxed"><code>curl -s https://starwars-holocron.vercel.app/api/characters/1</code></pre>
        </div>

        <!-- Terminal Output Response Console -->
        <div class="p-5 bg-[#080808] font-mono text-xs">
          <div class="flex items-center justify-between mb-2 text-[#A3A3A3] text-[11px] pb-2 border-b border-[#3D3D3D]/30">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#7FFFD4] animate-pulse"></span>
              <span class="text-[#F8FFF0] font-bold">RESPUESTA HTTP JSON</span>
            </span>
            <span id="response-status" class="text-[#7FFFD4] font-semibold">200 OK • Edge</span>
          </div>

          <pre id="terminal-json-output" class="text-[#F8FFF0]/90 max-h-64 overflow-y-auto leading-relaxed text-[11px] bg-[#0E0E0E] p-4 rounded-xl border border-[#3D3D3D]/40"><code>&#123;
  "id": "1",
  "name": "Luke Skywalker",
  "species": ["Human"],
  "homeworld": "Tatooine",
  "height_cm": 172,
  "status": "Jedi Master",
  "avatar_url": "/images/characters/luke-skywalker.jpeg"
&#125;</code></pre>
        </div>
      </div>

      <!-- Specs & Open Dev Cards (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-4">
        
        <!-- Spec Card 1 -->
        <div class="p-6 rounded-2xl bg-[#0E0E0E] border border-[#3D3D3D] hover:border-[#7FFFD4]/50 transition-colors">
          <div class="w-10 h-10 rounded-xl bg-[#7FFFD4]/10 border border-[#7FFFD4]/30 flex items-center justify-center text-[#7FFFD4] text-xl mb-3">
            ⚡
          </div>
          <h3 class="text-base font-bold text-[#F8FFF0] font-['Orbitron',sans-serif]">
            Cero Latencia en el Edge
          </h3>
          <p class="text-xs text-[#A3A3A3] mt-1.5 leading-relaxed">
            Todas las rutas de la API corren sobre Vercel Edge Network con dataset canónico en memoria local. Sin cuellos de botella ni pausas de bases de datos externas.
          </p>
        </div>

        <!-- Spec Card 2 -->
        <div class="p-6 rounded-2xl bg-[#0E0E0E] border border-[#3D3D3D] hover:border-[#7FFFD4]/50 transition-colors">
          <div class="w-10 h-10 rounded-xl bg-[#7FFFD4]/10 border border-[#7FFFD4]/30 flex items-center justify-center text-[#7FFFD4] text-xl mb-3">
            🌐
          </div>
          <h3 class="text-base font-bold text-[#F8FFF0] font-['Orbitron',sans-serif]">
            CORS & Headers Abiertos
          </h3>
          <p class="text-xs text-[#A3A3A3] mt-1.5 leading-relaxed">
            Consúmela libremente desde cualquier aplicación web, React, Vue, Flutter, SwiftUI o backend sin bloqueos de origen cruzado ni necesidad de API Keys.
          </p>
        </div>

        <!-- Spec Card 3 -->
        <div class="p-6 rounded-2xl bg-[#0E0E0E] border border-[#3D3D3D] hover:border-[#7FFFD4]/50 transition-colors">
          <div class="w-10 h-10 rounded-xl bg-[#7FFFD4]/10 border border-[#7FFFD4]/30 flex items-center justify-center text-[#7FFFD4] text-xl mb-3">
            📚
          </div>
          <h3 class="text-base font-bold text-[#F8FFF0] font-['Orbitron',sans-serif]">
            Documentación Interactiva Starlight
          </h3>
          <p class="text-xs text-[#A3A3A3] mt-1.5 leading-relaxed">
            Explora la guía completa de integración, modelos de respuesta DTO, filtros de búsqueda y ejemplos listos para copiar.
          </p>
          <a
            href="/introduccion"
            class="inline-flex items-center gap-2 mt-3 text-xs font-['Orbitron',sans-serif] text-[#7FFFD4] hover:underline font-bold"
          >
            <span>Ver Documentación de Rutas</span>
            <span>→</span>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  let currentLang = "curl";
  let currentEndpoint = "/api/characters/1";

  const snippets: Record<string, (ep: string) => string> = {
    curl: (ep) => `curl -s https://starwars-holocron.vercel.app${ep}`,
    js: (ep) => `// Consumo nativo en JavaScript / TypeScript
const response = await fetch("https://starwars-holocron.vercel.app${ep}");
const data = await response.json();
console.log(data);`,
    python: (ep) => `# Consumo con requests en Python
import requests

url = "https://starwars-holocron.vercel.app${ep}"
data = requests.get(url).json()
print(data)`,
  };

  function updateSnippet() {
    const display = document.getElementById("code-snippet-display");
    if (!display) return;
    const code = snippets[currentLang]?.(currentEndpoint) || "";
    display.textContent = code;
  }

  // Tabs
  document.querySelectorAll<HTMLButtonElement>(".terminal-tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".terminal-tab-btn").forEach((b) => {
        b.classList.remove("active", "bg-[#7FFFD4]", "text-[#0A0A0A]", "font-bold");
        b.classList.add("text-[#A3A3A3]");
      });
      btn.classList.add("active", "bg-[#7FFFD4]", "text-[#0A0A0A]", "font-bold");
      btn.classList.remove("text-[#A3A3A3]");
      currentLang = btn.getAttribute("data-lang") || "curl";
      updateSnippet();
    });
  });

  // Selector
  const selector = document.getElementById("endpoint-selector") as HTMLSelectElement;
  if (selector) {
    selector.addEventListener("change", (e) => {
      currentEndpoint = (e.target as HTMLSelectElement).value;
      updateSnippet();
    });
  }

  // Copiar
  const copyBtn = document.getElementById("copy-snippet-btn");
  const copyText = document.getElementById("copy-text");
  if (copyBtn && copyText) {
    copyBtn.addEventListener("click", async () => {
      const code = snippets[currentLang]?.(currentEndpoint) || "";
      await navigator.clipboard.writeText(code);
      copyText.textContent = "¡Copiado!";
      setTimeout(() => {
        copyText.textContent = "Copiar";
      }, 2000);
    });
  }

  // Ejecutar Live Request
  const execBtn = document.getElementById("execute-request-btn");
  const jsonOutput = document.getElementById("terminal-json-output");
  const statusDisplay = document.getElementById("response-status");

  if (execBtn && jsonOutput && statusDisplay) {
    execBtn.addEventListener("click", async () => {
      execBtn.textContent = "Cargando...";
      statusDisplay.textContent = "FETCHING...";

      try {
        const start = performance.now();
        const res = await fetch(currentEndpoint);
        const data = await res.json();
        const duration = Math.round(performance.now() - start);

        statusDisplay.textContent = `${res.status} ${res.statusText} • ${duration}ms`;
        jsonOutput.textContent = JSON.stringify(data, null, 2);
      } catch (err) {
        statusDisplay.textContent = "ERROR 500";
        jsonOutput.textContent = `Error al ejecutar la consulta: ${String(err)}`;
      } finally {
        execBtn.textContent = "▶ Ejecutar";
      }
    });
  }
</script>
