---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Star Wars Holocron API",
  description = "Catálogo interactivo del universo Star Wars",
  image = "/images/logos/logo.png",
} = Astro.props;

// Construimos la URL canónica (si existe Astro.site o la base actual)
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || Astro.url.origin,
);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" href="/images/logos/logo.png" />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta
  property="og:image"
  content={new URL(image, Astro.site || Astro.url.origin)}
/>

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta
  property="twitter:image"
  content={new URL(image, Astro.site || Astro.url.origin)}
/>

<meta name="theme-color" content="#000000" />
