---
// Hero.astro - Portada Épica con Three.js Starfield y Métricas del Holocron
import Logo from "@presentation/common/Logo.astro";
---

<section class="relative w-full min-h-[92vh] flex flex-col items-center justify-center overflow-hidden pt-24 pb-16 px-4">
  <!-- Three.js Starfield Canvas Background -->
  <canvas id="starfield-canvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-70"></canvas>

  <!-- Ambient Neon Mint Glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#7FFFD4]/10 blur-[140px] rounded-full pointer-events-none"></div>
  <div class="absolute bottom-12 right-12 w-[450px] h-[280px] bg-[#3D3D3D]/30 blur-[130px] rounded-full pointer-events-none"></div>

  <!-- Content Container -->
  <div class="relative z-10 w-full max-w-5xl mx-auto text-center flex flex-col items-center">
    
    <!-- Top Cyber Badge -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#0A0A0A]/90 border border-[#7FFFD4]/30 text-[#7FFFD4] text-xs font-mono font-semibold uppercase tracking-widest mb-8 shadow-[0_0_20px_rgba(127,255,212,0.2)]">
      <span class="w-2 h-2 rounded-full bg-[#7FFFD4] animate-ping"></span>
      <span>CANON REST API • V1.0 GALACTIC ARCHIVE</span>
    </div>

    <!-- Main Title with Logo Presentation -->
    <div class="mb-4">
      <Logo size="lg" />
    </div>

    <!-- Subtitle -->
    <p class="mt-4 text-base sm:text-xl text-[#F8FFF0]/85 max-w-2xl font-['Inter',sans-serif] leading-relaxed font-light">
      El archivo digital definitivo de Star Wars. Explora más de <span class="text-[#7FFFD4] font-semibold">360 personajes oficiales</span> con biometría canónica, retratos en alta definición y una API REST servida a <span class="text-[#7FFFD4] font-semibold">0ms en el Edge</span>.
    </p>

    <!-- CTAs -->
    <div class="mt-8 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
      <a
        href="/characters"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#7FFFD4] text-[#0A0A0A] font-extrabold font-['Orbitron',sans-serif] text-sm tracking-wider uppercase hover:bg-white transition-all hover:scale-105 shadow-[0_0_25px_rgba(127,255,212,0.6)] flex items-center justify-center gap-2"
      >
        <span>⚔️ Explorar Personajes</span>
        <span class="font-mono text-xs">(364)</span>
      </a>

      <a
        href="#terminal-sandbox"
        class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-[#0A0A0A]/90 hover:bg-[#3D3D3D]/40 text-[#7FFFD4] border border-[#7FFFD4]/30 font-['Orbitron',sans-serif] text-sm tracking-wider uppercase transition-all hover:border-[#7FFFD4] flex items-center justify-center gap-2"
      >
        <span>⚡ Probar API en Vivo</span>
        <span>↓</span>
      </a>

      <a
        href="/introduccion"
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-transparent hover:bg-[#3D3D3D]/20 text-[#F8FFF0]/80 border border-[#3D3D3D] font-['Orbitron',sans-serif] text-xs tracking-wider uppercase transition-all flex items-center justify-center gap-2"
      >
        <span>📜 Documentación</span>
        <span>↗</span>
      </a>
    </div>

    <!-- Métricas Galácticas -->
    <div class="mt-14 grid grid-cols-2 sm:grid-cols-4 gap-4 w-full max-w-3xl">
      <div class="p-4 rounded-xl bg-[#0A0A0A]/80 border border-[#3D3D3D] backdrop-blur-md hover:border-[#7FFFD4]/40 transition-colors">
        <p class="text-2xl sm:text-3xl font-extrabold text-[#7FFFD4] font-['Orbitron',sans-serif]">364</p>
        <p class="text-[11px] text-[#A3A3A3] mt-1 uppercase tracking-wider font-mono">Personajes</p>
      </div>

      <div class="p-4 rounded-xl bg-[#0A0A0A]/80 border border-[#3D3D3D] backdrop-blur-md hover:border-[#7FFFD4]/40 transition-colors">
        <p class="text-2xl sm:text-3xl font-extrabold text-[#F8FFF0] font-['Orbitron',sans-serif]">338</p>
        <p class="text-[11px] text-[#A3A3A3] mt-1 uppercase tracking-wider font-mono">Retratos HD</p>
      </div>

      <div class="p-4 rounded-xl bg-[#0A0A0A]/80 border border-[#3D3D3D] backdrop-blur-md hover:border-[#7FFFD4]/40 transition-colors">
        <p class="text-2xl sm:text-3xl font-extrabold text-[#7FFFD4] font-['Orbitron',sans-serif]">0ms</p>
        <p class="text-[11px] text-[#A3A3A3] mt-1 uppercase tracking-wider font-mono">Edge Latency</p>
      </div>

      <div class="p-4 rounded-xl bg-[#0A0A0A]/80 border border-[#3D3D3D] backdrop-blur-md hover:border-[#7FFFD4]/40 transition-colors">
        <p class="text-2xl sm:text-3xl font-extrabold text-[#F8FFF0] font-['Orbitron',sans-serif]">100%</p>
        <p class="text-[11px] text-[#A3A3A3] mt-1 uppercase tracking-wider font-mono">Canon Oficial</p>
      </div>
    </div>

  </div>
</section>

<script>
  import { Starfield } from "@lib/three/Starfield.ts";

  function initStarfield() {
    const canvas = document.getElementById(
      "starfield-canvas",
    ) as HTMLCanvasElement;
    if (!canvas) return;
    const sf = new Starfield(canvas);

    document.addEventListener("astro:before-swap", () => sf.destroy(), {
      once: true,
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initStarfield, { once: true });
  } else {
    initStarfield();
  }
</script>
