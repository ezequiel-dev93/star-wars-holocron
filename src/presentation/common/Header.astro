---
import NavItem from "@presentation/common/NavItem.astro";
import DocsIcon from "@presentation/components/icons/DocsIcon.astro";
import MenuIcon from "@presentation/components/icons/MenuIcon.astro";
import CloseIcon from "@presentation/components/icons/CloseIcon.astro";
import Logo from "@presentation/common/Logo.astro";
---

<header id="site-header" class="site-header">
  <div class="header-inner">
    <!-- Brand con Logo Holocron -->
    <div class="header-brand">
      <a
        href="/"
        class="header-logo-link"
        aria-label="Star Wars Holocron — Inicio"
      >
        <Logo size="sm" />
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="header-desktop-nav" aria-label="Navegación principal">
      <ul class="header-nav-list">
        <li>
          <NavItem href="/characters" class="header-nav-link" data-nav="characters">
            Personajes
          </NavItem>
        </li>
        <li>
          <NavItem href="/planets" class="header-nav-link" data-nav="planets">
            Planetas
          </NavItem>
        </li>
        <li>
          <NavItem href="/movies" class="header-nav-link" data-nav="movies">
            Películas
          </NavItem>
        </li>
        <li>
          <NavItem href="/weapons" class="header-nav-link" data-nav="weapons">
            Armas
          </NavItem>
        </li>
      </ul>
    </nav>

    <!-- Right Actions -->
    <div class="header-right">
      <a href="/introduccion" class="header-docs-btn">
        <DocsIcon size={14} aria-hidden="true" />
        <span>Docs API</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        class="mobile-menu-btn"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav-container"
      >
        <MenuIcon id="menu-icon" />
        <CloseIcon id="close-icon" style="display: none;" />
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <nav
    id="mobile-nav-container"
    class="header-mobile-nav"
    aria-label="Navegación móvil"
  >
    <ul class="mobile-nav-list">
      <li>
        <NavItem href="/characters" class="mobile-nav-link" data-nav="characters">
          Personajes
        </NavItem>
      </li>
      <li>
        <NavItem href="/planets" class="mobile-nav-link" data-nav="planets">
          Planetas
        </NavItem>
      </li>
      <li>
        <NavItem href="/movies" class="mobile-nav-link" data-nav="movies">
          Películas
        </NavItem>
      </li>
      <li>
        <NavItem href="/weapons" class="mobile-nav-link" data-nav="weapons">
          Armas
        </NavItem>
      </li>
      <li>
        <a href="/introduccion" class="mobile-nav-link text-[#7FFFD4] font-semibold">
          Documentación REST API ↗
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    width: 100%;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(127, 255, 212, 0.15);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.7);
    transition: all 0.3s ease;
  }

  .site-header.is-scrolled {
    background: rgba(10, 10, 10, 0.96);
    border-bottom-color: rgba(127, 255, 212, 0.3);
    box-shadow: 0 8px 32px rgba(127, 255, 212, 0.08);
  }

  .header-inner {
    width: 92%;
    max-width: 1750px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0;
    height: 70px;
  }

  /* Brand */
  .header-brand {
    display: flex;
    align-items: center;
  }

  .header-logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  /* Desktop Nav */
  .header-desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .header-desktop-nav {
      display: flex;
      align-items: center;
    }
  }

  .header-nav-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0.25rem 0.5rem;
    background: rgba(61, 61, 61, 0.25);
    border: 1px solid rgba(61, 61, 61, 0.5);
    border-radius: 9999px;
  }

  .header-nav-link {
    position: relative;
    display: inline-block;
    padding: 0.45rem 1.1rem;
    font-size: 0.82rem;
    font-family: var(--font-orbitron);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(248, 255, 240, 0.75);
    border-radius: 9999px;
    transition: all 0.25s ease;
  }

  .header-nav-link:hover {
    color: #7FFFD4;
    background: rgba(127, 255, 212, 0.1);
    text-shadow: 0 0 8px rgba(127, 255, 212, 0.5);
  }

  .header-nav-link.is-active {
    color: #7FFFD4;
    background: rgba(127, 255, 212, 0.15);
    border: 1px solid rgba(127, 255, 212, 0.35);
    text-shadow: 0 0 10px rgba(127, 255, 212, 0.6);
  }

  /* Right Actions */
  .header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-docs-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    font-size: 0.8rem;
    font-family: var(--font-orbitron);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #7FFFD4;
    border: 1px solid rgba(127, 255, 212, 0.4);
    border-radius: 8px;
    background: rgba(127, 255, 212, 0.08);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .header-docs-btn:hover {
    color: #0A0A0A;
    background: #7FFFD4;
    box-shadow: 0 0 18px rgba(127, 255, 212, 0.6);
  }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: rgba(248, 255, 240, 0.85);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 6px;
    transition: color 0.2s ease;
  }

  @media (max-width: 767px) {
    .mobile-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  /* Mobile Navigation Drawer */
  .header-mobile-nav {
    display: none;
    flex-direction: column;
    padding: 1rem 1.5rem;
    background: rgba(10, 10, 10, 0.98);
    border-bottom: 1px solid rgba(127, 255, 212, 0.2);
  }

  .header-mobile-nav.is-open {
    display: flex;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 1rem;
    font-family: var(--font-orbitron);
    font-size: 0.9rem;
    color: rgba(248, 255, 240, 0.8);
    border-radius: 8px;
    border: 1px solid rgba(61, 61, 61, 0.4);
    transition: all 0.2s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.is-active {
    color: #7FFFD4;
    background: rgba(127, 255, 212, 0.1);
    border-color: rgba(127, 255, 212, 0.35);
  }
</style>

<script>
  const header = document.getElementById("site-header");

  function updateHeader() {
    if (!header) return;
    if (window.scrollY > 20) {
      header.classList.add("is-scrolled");
    } else {
      header.classList.remove("is-scrolled");
    }
  }

  window.addEventListener("scroll", updateHeader, { passive: true });
  updateHeader();

  const currentPath = window.location.pathname;
  document
    .querySelectorAll<HTMLAnchorElement>(".header-nav-link, .mobile-nav-link")
    .forEach((link) => {
      const href = link.getAttribute("href");
      if (href && href !== "/" && currentPath.startsWith(href)) {
        link.classList.add("is-active");
      }
    });

  const mobileMenuBtn = document.getElementById("mobile-menu-toggle");
  const navContainer = document.getElementById("mobile-nav-container");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");

  if (mobileMenuBtn && navContainer && menuIcon && closeIcon) {
    mobileMenuBtn.addEventListener("click", () => {
      navContainer.classList.toggle("is-open");
      const isOpen = navContainer.classList.contains("is-open");
      
      mobileMenuBtn.setAttribute("aria-expanded", isOpen.toString());
      mobileMenuBtn.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");

      if (isOpen) {
        menuIcon.style.display = "none";
        closeIcon.style.display = "block";
      } else {
        menuIcon.style.display = "block";
        closeIcon.style.display = "none";
      }
    });
  }
</script>
