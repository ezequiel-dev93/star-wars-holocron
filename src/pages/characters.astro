---
import Layout from "@layouts/Layout.astro";
import Header from "@presentation/common/Header.astro";
import SectionContainer from "@presentation/common/SectionContainer.astro";
import CharacterGrid from "@/presentation/components/characters/CharacterGrid.astro";
import CharacterModal from "@/presentation/components/characters/CharacterModal.astro";
import { getCharactersUseCase, characterRepository } from "@/config/dependencies";
import type { CharacterDTO } from "@/modules/characters/application/dtos/CharacterDTO";

const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get("page") || "1"));
const query = (url.searchParams.get("q") || "").trim();

let characters: CharacterDTO[] = [];
let total = 0;
let totalPages = 1;
let hasNext = false;
let hasPrevious = false;

if (query) {
  const searched = await characterRepository.search(query);
  total = searched.length;
  totalPages = Math.max(1, Math.ceil(total / 24));
  const start = (page - 1) * 24;
  characters = searched.slice(start, start + 24).map((c) => ({
    id: c.id,
    name: c.name,
    height: c.height,
    mass: c.mass,
    hairColor: c.hairColor,
    skinColor: c.skinColor,
    eyeColor: c.eyeColor,
    birthYear: c.birthYear,
    gender: c.gender,
    homeworldUrl: c.homeworld,
    imageUrl: `/images/characters/${c.id}.jpeg`,
    description: c.description,
    avatarUrl: c.avatarUrl,
    isFavorite: c.isFavorite,
  }));
  hasNext = page < totalPages;
  hasPrevious = page > 1;
} else {
  const result = await getCharactersUseCase.execute(page, 24);
  characters = result.characters;
  total = result.total;
  totalPages = result.totalPages;
  hasNext = result.hasNext;
  hasPrevious = result.hasPrevious;
}

const buildPageUrl = (p: number) => {
  const params = new URLSearchParams(url.searchParams);
  params.set("page", String(p));
  return `/characters?${params.toString()}`;
};
---

<Layout
  title="Catálogo de Personajes | Star Wars Holocron"
  description="Archivo canónico oficial de Star Wars con 364 personajes, biometría, afiliaciones y visor JSON en vivo."
>
  <Header />

  <main class="pt-28 pb-24 min-h-screen bg-[#0A0A0A] text-[#F8FFF0]">
    <SectionContainer>
      <!-- Encabezado Sci-Fi -->
      <section class="mb-8 pt-4 pb-6 border-b border-[#3D3D3D] flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#141414] border border-[#7FFFD4]/30 text-[#7FFFD4] text-xs font-semibold uppercase tracking-widest mb-2.5 font-['Orbitron',sans-serif]">
            <span class="w-2 h-2 rounded-full bg-[#7FFFD4] animate-pulse shadow-[0_0_8px_#7FFFD4]"></span>
            Base de Datos Galáctica
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#F8FFF0] tracking-wide font-['Orbitron',sans-serif] neon-mint">
            PERSONAJES DEL CANON
          </h1>
          <p class="text-[#A3A3A3] text-sm sm:text-base mt-2 max-w-2xl font-['Inter',sans-serif]">
            Explora {total} registros canónicos de la galaxia. Haz click en cualquier tarjeta para ver su <span class="text-[#7FFFD4] font-semibold">Ficha Técnica</span> y su respuesta <span class="text-[#7FFFD4] font-semibold font-mono">JSON en tiempo real</span>.
          </p>
        </div>

        <!-- Buscador Holográfico -->
        <form method="GET" action="/characters" class="w-full lg:w-96">
          <div class="relative">
            <input
              type="text"
              name="q"
              value={query}
              placeholder="Buscar por nombre, especie, bio..."
              class="w-full bg-[#0E0E0E] border border-[#3D3D3D] rounded-xl px-4 py-3 pl-11 text-sm text-[#F8FFF0] placeholder-[#737373] focus:outline-none focus:border-[#7FFFD4] focus:ring-1 focus:ring-[#7FFFD4] transition-all font-mono shadow-[0_0_15px_rgba(127,255,212,0.08)]"
            />
            <svg
              class="absolute left-3.5 top-3.5 w-4 h-4 text-[#7FFFD4]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            {query && (
              <a
                href="/characters"
                class="absolute right-3.5 top-3 text-xs text-[#7FFFD4] hover:text-white font-mono bg-[#1A1A1A] px-2 py-0.5 rounded border border-[#3D3D3D]"
              >
                Limpiar ✕
              </a>
            )}
          </div>
        </form>
      </section>

      <!-- Grid de Personajes Flotante -->
      {characters.length > 0 ? (
        <CharacterGrid characters={characters} />
      ) : (
        <div class="text-center py-28 border border-dashed border-[#3D3D3D] rounded-2xl bg-[#0E0E0E]">
          <p class="text-xl text-[#F8FFF0] font-bold mb-2 font-['Orbitron',sans-serif]">Registro No Encontrado</p>
          <p class="text-sm text-[#A3A3A3] mb-6 font-mono">No hay archivos en el Holocron que coincidan con "{query}".</p>
          <a
            href="/characters"
            class="inline-flex items-center px-5 py-2.5 bg-[#7FFFD4] text-[#0A0A0A] font-bold rounded-lg text-xs tracking-wider uppercase hover:bg-white transition-colors font-['Orbitron',sans-serif] shadow-[0_0_15px_rgba(127,255,212,0.4)]"
          >
            Restablecer Búsqueda
          </a>
        </div>
      )}

      <!-- Barra de Paginación Galáctica -->
      {totalPages > 1 && (
        <nav aria-label="Paginación del Holocron" class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-[#3D3D3D] pt-6">
          <div class="text-xs font-mono text-[#A3A3A3]">
            REGISTROS <span class="font-bold text-[#7FFFD4]">{(page - 1) * 24 + 1} - {Math.min(page * 24, total)}</span> DE{" "}
            <span class="font-bold text-[#F8FFF0]">{total}</span> (PÁGINA {page} / {totalPages})
          </div>

          <div class="flex items-center gap-2">
            {hasPrevious ? (
              <a
                href={buildPageUrl(page - 1)}
                class="px-4 py-2 text-xs font-bold rounded-lg bg-[#141414] text-[#7FFFD4] hover:bg-[#7FFFD4] hover:text-[#0A0A0A] border border-[#3D3D3D] transition-all font-['Orbitron',sans-serif]"
              >
                ← Anterior
              </a>
            ) : (
              <span class="px-4 py-2 text-xs font-bold rounded-lg bg-[#0E0E0E] text-[#525252] border border-[#262626] cursor-not-allowed font-['Orbitron',sans-serif]">
                ← Anterior
              </span>
            )}

            <span class="px-3 py-1.5 rounded-lg bg-[#0E0E0E] border border-[#7FFFD4]/30 text-xs font-mono text-[#7FFFD4] font-bold">
              {page}
            </span>

            {hasNext ? (
              <a
                href={buildPageUrl(page + 1)}
                class="px-4 py-2 text-xs font-bold rounded-lg bg-[#141414] text-[#7FFFD4] hover:bg-[#7FFFD4] hover:text-[#0A0A0A] border border-[#3D3D3D] transition-all font-['Orbitron',sans-serif]"
              >
                Siguiente →
              </a>
            ) : (
              <span class="px-4 py-2 text-xs font-bold rounded-lg bg-[#0E0E0E] text-[#525252] border border-[#262626] cursor-not-allowed font-['Orbitron',sans-serif]">
                Siguiente →
              </span>
            )}
          </div>
        </nav>
      )}
    </SectionContainer>
  </main>

  <!-- Inspector Modal (Ficha Técnica + Visor JSON) -->
  <CharacterModal />
</Layout>
