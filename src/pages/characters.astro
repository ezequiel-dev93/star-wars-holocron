---
import Layout from "@layouts/Layout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import SectionContainer from "@components/ui/SectionContainer.astro";
import Link from "@components/ui/Link.astro";
import CharacterGrid from "@modules/characters/components/CharacterGrid.astro";
import CharacterModal from "@modules/characters/components/CharacterModal.astro";
import {
  getCharactersUseCase,
  type CharacterDTO,
} from "@core/characters";

const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get("page") || "1"));
const query = (url.searchParams.get("q") || "").trim();
const species = (url.searchParams.get("species") || "").trim();
const planet = (url.searchParams.get("planet") || "").trim();
const gender = (url.searchParams.get("gender") || "").trim();
const missingImage = url.searchParams.get("missing") === "1";
const pageSize = 24;

const result = await getCharactersUseCase.execute({
  query,
  species,
  planet,
  gender,
  missingImage,
  page,
  pageSize,
});

const characters: CharacterDTO[] = result.characters;
const total = result.total;
const totalPages = result.totalPages;
const hasNext = result.hasNext;
const hasPrevious = result.hasPrevious;

const hasActiveFilters = Boolean(
  query || species || planet || gender || missingImage
);

const buildPageUrl = (p: number) => {
  const params = new URLSearchParams(url.searchParams);
  params.set("page", String(p));
  return `/characters?${params.toString()}`;
};

const quickFilters = [
  {
    label: "Todos (364)",
    href: "/characters",
    active: !hasActiveFilters,
  },
  {
    label: "👤 Humanos",
    href: "/characters?species=Human",
    active: species.toLowerCase() === "human",
  },
  {
    label: "🤖 Droides",
    href: "/characters?species=Droid",
    active: species.toLowerCase() === "droid",
  },
  {
    label: "🪐 Tatooine",
    href: "/characters?planet=Tatooine",
    active: planet.toLowerCase() === "tatooine",
  },
  {
    label: "🪐 Naboo",
    href: "/characters?planet=Naboo",
    active: planet.toLowerCase() === "naboo",
  },
  {
    label: "🪐 Coruscant",
    href: "/characters?planet=Coruscant",
    active: planet.toLowerCase() === "coruscant",
  },
  {
    label: "📸 Sin Foto (Para Colaborar)",
    href: "/characters?missing=1",
    active: missingImage,
  },
];
---

<Layout
  title="Catálogo de Personajes | Star Wars Holocron"
  description="Catálogo completo de Star Wars con 364 personajes, historia, datos físicos y visor JSON en vivo."
>
  <Header />

  <main class="pt-28 pb-24 min-h-screen bg-base text-primary">
    <SectionContainer>
      <!-- Encabezado Sci-Fi -->
      <section class="mb-6 pt-4 pb-6 border-b border-smoke flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface border border-accent/30 text-accent text-xs font-semibold uppercase tracking-widest mb-2.5 font-orbitron">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse shadow-[0_0_8px_rgba(127,255,212,0.8)]"></span>
            Base de Datos Galáctica
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-primary tracking-wide font-orbitron neon-mint">
            PERSONAJES DE STAR WARS
          </h1>
          <p class="text-muted text-sm sm:text-base mt-2 max-w-2xl font-inter">
            Mostrando <span class="text-primary font-semibold">{total}</span> personajes. Haz click en cualquier tarjeta para ver su{" "}
            <span class="text-accent font-semibold">Ficha Completa</span>, apariciones en películas/series y su respuesta{" "}
            <span class="text-accent font-semibold font-mono">JSON en vivo</span>.
          </p>
        </div>

        <!-- Buscador Holográfico -->
        <form method="GET" action="/characters" class="w-full lg:w-96">
          <div class="relative">
            <input
              type="text"
              name="q"
              value={query}
              placeholder="Buscar por nombre, película, planeta..."
              class="w-full bg-card border border-smoke rounded-xl px-4 py-3 pl-11 text-sm text-primary placeholder-dim focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all font-mono shadow-[0_0_15px_rgba(127,255,212,0.08)]"
            />
            <svg
              class="absolute left-3.5 top-3.5 w-4 h-4 text-accent"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              ></path>
            </svg>
            {hasActiveFilters && (
              <Link
                href="/characters"
                variant="unstyled"
                class="absolute right-3.5 top-3 text-xs text-accent hover:text-primary font-mono bg-surface px-2 py-0.5 rounded border border-smoke"
              >
                Limpiar ✕
              </Link>
            )}
          </div>
        </form>
      </section>

      <!-- Barra de Filtros Rápidos -->
      <div class="mb-8 flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-muted mr-1">Filtrar por:</span>
        {quickFilters.map((f) => (
          <Link
            href={f.href}
            variant="unstyled"
            class={`px-3.5 py-1.5 rounded-xl text-xs font-mono transition-all ${
              f.active
                ? "bg-accent text-base font-bold shadow-[0_0_15px_rgba(127,255,212,0.35)]"
                : "bg-surface hover:bg-elevated text-muted hover:text-primary border border-smoke"
            }`}
          >
            {f.label}
          </Link>
        ))}
      </div>

      <!-- Grid de Personajes Flotante -->
      {characters.length > 0 ? (
        <CharacterGrid characters={characters} />
      ) : (
        <div class="text-center py-28 border border-dashed border-smoke rounded-2xl bg-card">
          <p class="text-xl text-primary font-bold mb-2 font-orbitron">
            Registro No Encontrado
          </p>
          <p class="text-sm text-muted mb-6 font-mono">
            No encontramos personajes con esos filtros en el Holocron.
          </p>
          <Link href="/characters" variant="primary" size="sm">
            Ver Todos los Personajes
          </Link>
        </div>
      )}

      <!-- Barra de Paginación Galáctica -->
      {totalPages > 1 && (
        <nav
          aria-label="Paginación del Holocron"
          class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-smoke pt-6"
        >
          <div class="text-xs font-mono text-muted">
            REGISTROS{" "}
            <span class="font-bold text-accent">
              {(page - 1) * pageSize + 1} - {Math.min(page * pageSize, total)}
            </span>{" "}
            DE <span class="font-bold text-primary">{total}</span> (PÁGINA {page} /{" "}
            {totalPages})
          </div>

          <div class="flex items-center gap-2">
            {hasPrevious ? (
              <Link href={buildPageUrl(page - 1)} variant="secondary" size="sm">
                ← Anterior
              </Link>
            ) : (
              <span class="px-4 py-2 text-xs font-bold rounded-xl bg-card text-dim border border-subtle cursor-not-allowed font-orbitron">
                ← Anterior
              </span>
            )}

            <span class="px-3.5 py-2 rounded-xl bg-card border border-accent/30 text-xs font-mono text-accent font-bold">
              {page}
            </span>

            {hasNext ? (
              <Link href={buildPageUrl(page + 1)} variant="secondary" size="sm">
                Siguiente →
              </Link>
            ) : (
              <span class="px-4 py-2 text-xs font-bold rounded-xl bg-card text-dim border border-subtle cursor-not-allowed font-orbitron">
                Siguiente →
              </span>
            )}
          </div>
        </nav>
      )}
    </SectionContainer>
  </main>

  <Footer />
  <CharacterModal />
</Layout>
