---
import Layout from "@layouts/Layout.astro";
import Header from "@presentation/common/Header.astro";
---

<Layout title="Armas | Star Wars Holocron" description="Explora las armas del universo Star Wars">
  <Header />

  <main class="pt-32 pb-16 px-4 min-h-screen">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 tracking-tight">
        Armas
      </h1>
      <p class="text-slate-400 text-lg mb-12 max-w-2xl">
        Explora las armas del universo Star Wars.
      </p>

      <div class="flex items-center justify-center py-20 border border-dashed border-slate-700 rounded-xl">
        <p class="text-slate-500 text-lg">Próximamente — Grid de armas</p>
      </div>
    </div>
  </main>
</Layout>
