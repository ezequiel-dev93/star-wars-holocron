---
import Layout from "@layouts/Layout.astro";
import Header from "@components/layout/Header.astro";
import Hero from "@components/home/Hero.astro";
import DevTerminal from "@components/home/DevTerminal.astro";
import CommunitySection from "@components/home/CommunitySection.astro";
import ArchiveSectors from "@components/home/ArchiveSectors.astro";
import Footer from "@components/layout/Footer.astro";
---

<Layout
  title="Star Wars Holocron | Archivo Canónico & REST API"
  description="El archivo digital de Star Wars de alto nivel: 364 personajes canónicos, biometría completa, retratos HD y REST API servida a 0ms en el Edge."
>
  <Header />

  <main class="bg-base text-primary overflow-hidden">
    <Hero />
    <DevTerminal />
    <CommunitySection />
    <ArchiveSectors />
  </main>

  <Footer />
</Layout>
